# linux.config — конфигурация ядра для slattware.
#
# Собирается НЕ вручную через menuconfig, а файлом-фрагментом:
#   ./tools/build-kernel.sh
# Он берёт штатный defconfig ядра, применяет этот фрагмент поверх и
# собирает. Так конфигурация воспроизводима и её видно в git.
#
# Почему не menuconfig: конфиг на 5000 строк меняется руками и сразу
# теряется. Фрагмент — это только то, что мы отличаем от стандарта.
#
# Что здесь важно:
#   * DRM_AMDGPU=y — без него на ноутбуке с AMD не будет графики
#   * OVERLAY_FS=y  — без него нельзя обновлять систему на месте;
#                     сейчас обходим rename в bdd
#   * virtio/ext4 встроены, а не модулями: initramfs не умеет грузить
#     модули, корень обязан монтироваться вшитым драйвером
#   * ext4 встроена по той же причине

# DRM_AMDGPU сам объявляется как menu, конкретные опции — в его
# подфайлах. VCN в этом дереве нет (проверено по Kconfig), поэтому
# CONFIG_DRM_AMDGPU_VCN из ранней версии фрагмента убрана: merge_config
# такое имя молча проглатывает, и потом неясно, почему нет видео.
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_USERPTR=y
CONFIG_DRM_RADEON=y
# Настоящее имя — DRM_AMD_ISP, не AMD_ISP. Имя выдумано в ранней версии
# фрагмента, merge_config такое молча проглатывал.
CONFIG_DRM_AMD_ISP=y

# Обновления на месте. Модулем нельзя: нужен до монтирования корня.
CONFIG_OVERLAY_FS=y

# Встроенные драйверы корня. Модулем нельзя — initramfs не грузит модули.
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_BLK_DEV_SD=y
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_SCSI_MOD=y

# EFI: ядро само себя грузит, загрузчик нужен только для выбора ядра.
CONFIG_EFI_STUB=y
CONFIG_EFI_HANDOVER_PROTOCOL=y

# Безопасность входа.
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_TMPFS_XATTR=y
CONFIG_FS_POSIX_ACL=y
CONFIG_DEFAULT_FQ_CGROUP=y
CONFIG_CGROUPS=y

# Удобство в консоли и терминале.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNICODE=y
CONFIG_NLS=y
CONFIG_NLS_UTF8=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_USB_HID=y

# Простое шифрование диска для паролей и swap.
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_RNG=y

# Сеть и DNS, чтобы net-сервис dinit поднимался без плясок.
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETFILTER=y

# Отладочное, но полезное: видно, что происходит.
# CONFIG_DEBUG_FS в этом дереве не объявлен как самостоятельный символ —
# включать нечего, отладка идёт через dmesg и /proc.
CONFIG_MAGIC_SYSRQ=y
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1

# Убираем то, что не нужно на слабом железе и в виртуалке.
# (Секьюрность не отключаем — см. выше.)
# CONFIG_NETFILTER_XT_TARGET_TPROXY is not set

# Модулей поменьше: каждый .ko тащится в initramfs.
# В этом ядре DEBUG_INFO_DWARF5 не существует, а DWARF4 — это дефолт,
# выключать нечего.

# --- проверено против Kconfig дерева ---------------------------------------
# Все символы выше сверены с реальными Kconfig. merge_config не ругается
# на несуществующие имена — он их молча выкидывает, и потом неясно,
# почему в системе нет графики. Скрипт build-kernel.sh проверяет
# критичные символы после oldconfig, а перед этим весь список стоит
# прогонять так:
#
#   cd kernel/7.2.8
#   grep -oE '^CONFIG_[A-Z_0-9]+' ../../config/linux.config | sort -u |
#   while read c; do
#       find . -name Kconfig -exec grep -qE "^config ${c#CONFIG_}\$" {} + ||
#           echo "ВЫДУМАН: $c"
#   done
#
# Ложные срабатывания дают menu-символы (ATA, NLS, CRYPTO, CGROUPS,
# NETFILTER): они объявляются как menu и в Kconfig лежат под другим
# именем, но в .config существуют и включаются нормально.