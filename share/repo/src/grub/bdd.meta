version: 2.14
description: GRUB — загрузчик операционной системы
maintainer: aetherria
depends: busybox musl util-linux

# GRUB нужен внутри chroot, чтобы slattware-grub-install мог запустить
# grub-install на целевую систему. Ставится в связке с linux:
#
#   bdd install linux grub
#   slattware-grub-install /dev/sda
#
# install: ДВЕ раскладки, и обе обязательны.
#
#   grubmod → /usr/lib/grub
#       Модули GRUB. grub-install ищет их именно там; в
#       /usr/local/lib/grub/ их нет, и он падает с «cannot find a GRUB
#       drive for ...».
#
#   lib → /usr/lib
#       libdevmapper.so.1.02 и liblzma.so.5. Обычная раскладка пакета
#       кладёт библиотеки в /usr/local/lib/<имя>/, а загрузчик musl ищет
#       в /lib:/usr/local/lib:/usr/lib — подкаталога в этом списке нет.
#       Без этой строки grub-install не запускается вообще:
#           Error relocating /usr/local/bin/grub-install: dm_task_run:
#           symbol not found
#
# depends: util-linux — ради blkid, которым grub-install читает UUID и
# метки разделов.
#
# Модулей 1216 на 12 МБ. Они не компилируются, берутся с хоста.
install:
  grubmod  /usr/lib/grub
  lib      /usr/lib