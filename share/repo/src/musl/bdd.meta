version: 1.0
description: musl libc — загрузчик и базовая библиотека C для всей системы
maintainer: aetherria
depends:
# Система целиком musl. Пока пакет не установлен, в корне нет
# /lib/ld-musl-x86_64.so.1, и не запустится НИЧЕГО: ни busybox, ни dinit,
# ни сам bdd (он /bin/sh). То есть это пакет номер ноль.
#
# Раскладка по абсолютным путям: musl ждёт загрузчик в /lib/, а обычная
# раскладка положила бы его в /usr/local/lib/musl/.
#
# usr/lib/libc.so — симлинк для сборки: с ним линковщик находит libc под
# именем -lc. tcc без него не собирает ничего.
install:
  lib  /lib
  usr  /usr
