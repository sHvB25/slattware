#!/bin/busybox sh
# initramfs/init — первый процесс в системе.
#
# Задача: донести ядро и busybox до настоящей ФС, примонтировать
# виртуальные ФС и передать управление dinit через switch_root.

BB=/bin/busybox

# --- трассировка -----------------------------------------------------------
# ПОЧЕМУ ЭТО ЗДЕСЬ. Девять ошибок подряд выглядели одинаково: init
# стартует и замолкает. По логу QEMU видно только одно — упал или нет,
# — и причину приходилось угадывать. Каждая догадка стоила полного
# цикла «пересобрать initramfs → загрузить в QEMU → смотреть», а
# циклов ушло больше, чем следовало.
#
# Теперь init сам говорит, где находится. Если он умрёт — в логе
# будет последняя напечатанная строка, и это будет ответ, а не
# предмет догадок.
#
# Трассировка включается переменной init_trace в /proc/cmdline или
# аргументом, чтобы можно было грузиться и без неё:
#     init=/init slattware-live init_trace
#
# Каждая строка печатается ДО действия. Если после неё тишина —
# значит умерло именно на этом действии.

trace_on=
for _t in "$@"; do
    case "$_t" in
        init_trace) trace_on=1 ;;
    esac
done

# Метку init_trace тоже читаем из аргументов, а не из /proc/cmdline:
# /proc на момент старта init ещё не смонтирован.
for _a in "$@"; do
    case "$_a" in
        slattware-live) live_mode=1 ;;
        root=*)         root_arg=$_a ;;
    esac
done

step() {
    [ -n "$trace_on" ] || return 0
    $BB echo "[init] $*"
}

fail() {
    $BB echo "[init] СБОЙ: $*"
    $BB echo "[init] init дальше работать не может."
    # Не спим вечно молча: оставляем консоль в виду и ждём, чтобы
    # человек увидел причину и мог перезагрузиться.
    $BB sh -c "while :; do $BB sleep 1; done"
}

step "стартовал, аргументы = [$*]"

# --- /dev -----------------------------------------------------------------
# devtmpfs ОБЯЗАТЕЛЬНО идёт первым: именно он создаёт /dev/vda, /dev/ttyS0
# и остальные узлы. Без него блочных устройств просто не существует,
# и монтирование корня падает с "Can't lookup blockdev".
$BB mount -t devtmpfs devtmpfs /dev

# --- точка монтирования корня ----------------------------------------------
# Каталог для switch_root ОБЯЗАТЕЛЬНО должен существовать. В initramfs,
# собранном вручную через cpio, его нет: cpio кладёт в архив только то,
# что мы перечислили, а /newroot в списке не значился.
#
# ВАЖНО вызывать mkdir через $BB: в initramfs лежит только один файл
# /bin/busybox, отдельных программ нет, и голое `mkdir` завершает скрипт
# с «not found». Из-за этого init умирал ДО первой строки вывода —
# ядро писало «Attempted to kill init» с кодом 0, и диагностировать
# пришлось по косвенным признакам.
$BB mkdir -p /newroot

# --- корень ---------------------------------------------------------------
# ЯДРО ЖИВЫХ СРЕД. Если в метке ядра есть slattware-live, то это Live CD:
# корня на диске искать не надо, надо взять корень из initramfs.
#
# Проверка по метке в /proc/cmdline, а не по флажку из grub.cfg: метка
# не зависит от того, кто и как запускает ядро, и потому не забывается.
#
# Здесь нужен не print, а переход: раньше блок только печатал «режим:
# Live CD», а потом исполнение падало в общий поиск /dev/vda — диска
# на Live CD нет, и init завершался, не дойдя до switch_root.
# Отсюда и был «init used greatest stack depth» вместо оболочки.
# ЖИВОЙ РЕЖИМ ОПРЕДЕЛЯЕТСЯ БЕЗ /proc.
#
# /proc/cmdline читать нельзя: на этой строке /proc ещё не смонтирован,
# и cat возвращает «can't open /proc/cmdline». Тогда live_mode всегда
# пуст, init уходит искать /dev/vda, которого на Live CD нет, и весь
# режим молча не работает.
#
# Поэтому метку передаём самим init — аргументом. Это надёжнее чтения
# файла: не зависит от порядка монтирований и работает одинаково.
#
#   init=/init slattware-live      — Live CD, корень из liveroot.cpio.gz
#
# (разбор аргументов — выше, вместе с трассировкой; второй раз он тут
#  стоял и перетирал первый, из-за чего init_trace не включался)

if [ -n "$live_mode" ]; then
    # Перенаправлять вывод в /dev/ttyS0 НЕ нужно и даже вредно.
    # Проба с `exec > /dev/ttyS0` была лишней: если exec не срабатывает,
    # скрипт умирает ДО первого echo, и в логе это выглядит как «init
    # стартовал и замолчал» — самая запутанная картина из возможных.
    # init и так наследует stdout ядра, а тот уже привязан к консолям
    # из параметров ядра. Молчание init означает, что он не дошёл, а
    # не что ему некуда писать.
    step "режим Live CD: корень из live-root"

    # Живая система приходит вторым архивом и лежит в initramfs под
    # /liveroot.cpio.gz. Распаковываем прямо в /newroot.
    #
    # Отдельный архив нужен потому, что этот initramfs — общий для
    # двух случаев: обычной загрузки с диска и Live CD. В обычном
    # случае живую систему берём с раздела, и лишние 7 МБ в initramfs
    # были бы ballast'ом, который мы грузили бы в память зря.
    #
    # ВАЖНО: у busybox-cpio НЕТ опции -D. `cpio -idm -D /newroot` уходит
    # в ошибку, init на этом месте умирал, и всё выглядело как «init
    # стартует и молчит». Поэтому cd в подкаталоге, а не -D.
    if [ -f /liveroot.cpio.gz ]; then
        step "распаковываю /liveroot.cpio.gz"

        # /newroot ОБЯЗАТЕЛЬНО должен быть точкой монтирования, иначе
        # switch_root откажется: «NEW_ROOT must be a mountpoint» — он
        # печатает справку и выходит, init dies с SIGHUP, и в логе это
        # выглядит как «init исчез молча».
        #
        # В обычной загрузке /newroot — точка монтирования раздела.
        # В Live CD диска нет, поэтому монтируем tmpfs: система целиком
        # в памяти, что для Live CD и правильно.
        step "монтирую tmpfs на /newroot (точка монтирования для switch_root)"
        $BB mount -t tmpfs -o size=256M tmpfs /newroot \
            || fail "не смог смонтировать tmpfs на /newroot"

        step "распаковываю live-root в /newroot"
        $BB gzip -dc /liveroot.cpio.gz | (cd /newroot && $BB cpio -idm) 2>/dev/null
        _rc=$?
        if [ ! -x /newroot/bin/busybox ]; then
            step "cpio не справился (rc=$_rc), пробую tar"
            $BB mkdir -p /newroot
            $BB gzip -dc /liveroot.cpio.gz | (cd /newroot && $BB tar xf -) 2>/dev/null
        fi
        [ -x /newroot/bin/busybox ] \
            || fail "НЕ РАСПАКОВАЛСЯ /liveroot.cpio.gz (rc=$_rc)"
        step "живая система распакована, в корне $($BB ls /newroot | $BB wc -l) записей"
    else
        $BB echo "нет /liveroot.cpio.gz — метка slattware-live есть, живой системы нет."
        $BB echo "Пересобери ISO: ./tools/mkiso.sh"
        $BB sh -c "while :; do $BB sleep 1; done"
    fi

    # /dev переезжает в корень, иначе узлы устройств останутся в initramfs.
    #
    # ВАЖНО: точек монтирования в live-root НЕТ, и bdd их не создаёт —
    # он раскладывает только файлы пакетов, а не каркас системы. При
    # обычной загрузке /newroot — раздел с готовым корнем, и dev/proc/sys
    # там уже есть. В Live CD корня на диске нет, и каталогов нет тоже:
    # mount без существующей цели падает с ENOENT.
    #
    # На это ушло несколько итераций вслепую, пока в init не появилась
    # трассировка: без неё был виден только паник ядра.
    step "создаю точки монтирования в /newroot"
    for _d in dev proc sys run tmp; do
        $BB mkdir -p "/newroot/$_d" || fail "не создать /newroot/$_d"
    done

    step "монтирую виртуальные ФС в /newroot"
    $BB mount -t devtmpfs devtmpfs /newroot/dev || fail "devtmpfs в /newroot/dev"
    $BB mount -t proc proc /newroot/proc             || fail "proc в /newroot/proc"
    $BB mount -t sysfs sysfs /newroot/sys           || fail "sysfs в /newroot/sys"
    $BB mount -t tmpfs -o size=16M,mode=755 tmpfs /newroot/run   || fail "run"
    $BB mount -t tmpfs -o size=64M,mode=1777 tmpfs /newroot/tmp || fail "tmp"

    # Апплеты: в live-root они уже есть (пакет busybox ставит их), но
    # лишний --install не помешает и закроет случай, если сборка
    # живой системы когда-нибудь будет неполной.
    step "ставлю апплеты busybox в /newroot/bin"
    $BB --install -s /newroot/bin

    step "проверяю, что в корне есть /init"
    # Именно -L, а не -e. /init это СИМЛИНК на /bin/dinit, путь
    # АБСОЛЮТНЫЙ, и до switch_root он резолвится от /, а не от
    # /newroot. Поэтому [ -e /newroot/init ] даёт ложь: dinit-то есть,
    # но по пути /bin/dinit, которого в initramfs нет и не должно быть.
    #
    # Проверять надо dinit по месту: он лежит в корне живой системы.
    [ -L /newroot/init ]    || fail "в /newroot нет /init — dinit не запустится"
    [ -x /newroot/bin/dinit ] \
        || fail "/newroot/init есть, но /newroot/bin/dinit не исполняем"

    step "вызываю switch_root в /newroot /init"
    # Метку пробрасываем аргументом: switch_root свои аргументы после
    # /init не передаёт, и живая система решила бы, что она не live.
    exec $BB switch_root -c /dev/console /newroot /init slattware-live
    # Сюда не дойдём: exec не возвращается. Если вернулся — значит
    # switch_root отказался, и без fail() init просто вышел бы молча.
    fail "switch_root вернулся с кодом $? — он не сменил корень"
fi

# Ищем корень перебором, а не одним устройством.
#
# Почему перебор: у нас два возможных вида корня, и оба должны работать.
#   /dev/vda1 — если диск разбит на разделы (partitioned.img, как в Arch:
#               ты сам решаешь, где система, а где /home)
#   /dev/vda  — если диск целиком, без таблицы разделов (старый disk.img)
# Раньше было жёстко $BB mount -t ext4 /dev/vda, и после появления
# разделов загрузка падала бы с «нет такого устройства».
#
# Порядок важен: сначала разделённый вариант, потому что метка LABEL=
# проверяется на каждом кандидате — так мы не смонтируем что попало.
#
# Список кандидатов шире, чем просто vda, потому что эта же система
# должна грузиться с Live CD на чужом железе. Под QEMU корни всегда
# /dev/vda*, но на реальной машине это /dev/nvme0n1p2, /dev/sda1 или
# даже /dev/sdb3 — имя нигде не записано, его узнать неоткуда.
#
# Поэтому: сначала пробуем известное (быстро, без вопросов), а если не
# нашлось — перечисляем все разделы и даём выбрать руками. Это ровно
# то место, где конструктор должен уступить человеку решение.
for dev in /dev/vda1 /dev/vda; do
    [ -b "$dev" ] || continue
    if $BB mount -t ext4 "$dev" /newroot 2>/dev/null; then
        ROOTDEV=$dev
        break
    fi
done

if [ -z "$ROOTDEV" ]; then
$BB echo
$BB echo "=========================================================="
    $BB echo " [А-Яа-я]втоматически корень не найден."
    $BB echo " [А-Яа-я]кажи раздел с корнем — так быстрее, чем выбирать из списка."
$BB echo "=========================================================="
$BB echo
    $BB echo "Разделы, которые видны:"
    for p in $($BB ls /dev/sd* /dev/nvme* /dev/hd* /dev/vd* 2>/dev/null); do
        [ -b "$p" ] || continue
        $BB echo "  $p"
    done

    while :; do
        $BB printf 'корень (например /dev/sda1 или nvme0n1p2): '
        _ans=$(read -r line 2>/dev/null) || _ans=""
        [ -n "$_ans" ] || continue
        # Без ведущего /dev — не беда, допишем.
        case "$_ans" in
            /*) _dev=$_ans ;;
            *)  _dev=/dev/$_ans ;;
        esac
        if [ ! -b "$_dev" ]; then
            $BB echo "нет такого устройства: $_dev"
            continue
        fi
        if $BB mount -t ext4 "$_dev" /newroot 2>/dev/null; then
            ROOTDEV=$_dev
            break
        fi
        $BB echo "не ext4 или не корень: $_dev"
        $BB umount /newroot 2>/dev/null || :
    done
    $BB echo "корень: $ROOTDEV"
fi
$BB echo "корень: $ROOTDEV"

# /dev переезжает в новый корень, иначе узлы устройств останутся в initramfs.
$BB mount -t devtmpfs devtmpfs /newroot/dev

# --- виртуальные ФС -------------------------------------------------------
# /proc и /sys монтируем ЗДЕСЬ, а не через fstab.
# Причина: сервис dinit, который делает mount -a, останавливается раньше
# остальных при выключении. Если /proc живёт только на этом сервисе,
# то в момент штатного завершения /proc/mounts уже недоступен и размонтирование
# падает с ошибкой. Примонтированный здесь /proc переживает остановку сервисов.
$BB mount -t proc proc /newroot/proc
$BB mount -t sysfs sysfs /newroot/sys

# --- временная память -----------------------------------------------------
# /run — pid-файлы и сокеты dinit. /tmp — для сборки: 16 МБ мало,
# tcc при компиляции больших файлов в это упирается.
$BB mount -t tmpfs -o size=16M,mode=755 tmpfs /newroot/run
$BB mount -t tmpfs -o size=64M,mode=1777 tmpfs /newroot/tmp

# --- ссылки busybox -------------------------------------------------------
# Раскладываем все апплеты busybox в /bin. Именно здесь, а не в build.sh:
# файловая система уже смонтирована и доступна для записи, поэтому
# ссылки гарантированно окажутся в работающей системе.
$BB --install -s /newroot/bin

# --- передача управления --------------------------------------------------
# -c /dev/console: консоль переназначается, иначе getty не найдёт терминал.
exec $BB switch_root -c /dev/console /newroot /init
