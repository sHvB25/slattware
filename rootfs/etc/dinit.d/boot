# Приглашение на ttyS0 с автоматическим входом.
#
# getty -n  : не спрашивать имя пользователя
# getty -l  : вместо /bin/login запустить наш скрипт автологина
#
# stop-timeout: getty завершается не мгновенно (ему надо отдать терминал),
# поэтому даём время на штатное завершение, а не убиваем сразу.
#
# Чтобы вернуть обычный вход root по паролю, убери -n и -l:
#   command = /bin/busybox getty -L 115200 ttyS0 vt100
type = process
command = /bin/busybox getty -L -n -l /etc/autologin.sh 115200 ttyS0 vt100
restart = true
stop-timeout = 2000
waits-for = etc
waits-for = net
waits-for = share
waits-for = hostname
waits-for = rc
