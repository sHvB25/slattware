# Сеть. Ждёт, чтобы поднялись базовые ФС.
#
# type = scripted, а НЕ internal: у сервиса типа internal команда не
# запускается вообще — dinit считает такой сервис выполненным сразу.
# Из-за этого /etc/net.sh молча не отрабатывал: в госте не было ни адреса
# на eth0, ни маршрута, интерфейс оставался DOWN. При этом dinitctl status
# честно показывал STARTED — сервис «успешно» ничего не сделал.
type = scripted
command = /etc/net.sh start
restart = false
waits-for = etc