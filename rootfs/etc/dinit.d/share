# 9p-шара с хостом. Монтируется отдельно от mount -a, потому что
# 9p-устройство появляется не сразу: нужно подождать и повторить.
#
# Логирование: dinit пишет в консоль. Отдельный log-file задаётся
# глобально в /etc/dinit.conf, а не в сервисе.
type = scripted
command = /etc/share.sh
restart = false
waits-for = etc
