#!/bin/sh
# /etc/rc.local — однократная инициализация при загрузке.
#
# Запускается сервисом /etc/dinit.d/rc: у dinit нет настройки bootcmd,
# поэтому «сделать один раз до приглашения» приходится оформлять
# отдельным сервисом.
#
# ВАЖНО: motd здесь НЕ печатается. Его показывает busybox login
# (в исходниках busybox login строка /etc/motd вшита). Раньше мы печатали
# его здесь — получалось два раза, если бы сервис вообще запускался.

BB=/bin/busybox

# dinit отдаёт сервису свой stdout, а не консоль. Пишем явно.
[ -c /dev/console ] && exec >/dev/console 2>&1

# --- каталоги --------------------------------------------------------------
# /var/lib/bdd и /var/cache/bdd входят в образ пустыми (директории без
# файлов в tar не попадают), поэтому создаём их здесь.
mkdir -p /var/log /var/lib/bdd/db /var/lib/bdd/files /var/lib/bdd/index \
         /var/cache/bdd /run/lock /var/tmp 2>/dev/null
chmod 1777 /var/tmp 2>/dev/null
chmod 755 /var/log /var/cache/bdd 2>/dev/null

# --- проверка целостности bdd ---------------------------------------------
if [ -x /usr/local/bin/bdd ]; then
    /usr/local/bin/bdd --version >/dev/null 2>&1 \
        || echo "warn: bdd не отвечает, проверь /usr/local/bin/bdd" >&2
    # Каталоги выше создались — значит, /var примонтирован и доступен
    # на запись. Если нет, пакеты ставить нечем, и об этом лучше сказать
    # сразу, чем через минуту странной ошибки от bdd.
    if [ ! -w /var/lib/bdd ]; then
        echo "warn: /var/lib/bdd недоступен на запись — пакеты не ставятся" >&2
    fi
else
    echo "warn: нет /usr/local/bin/bdd" >&2
fi

# --- время -----------------------------------------------------------------
# Время и часовой пояс выставляет /etc/share.sh: там 9p-шара уже смонтирована.
# Здесь только напоминание, если шары не было — дата останется как есть.
if [ ! -r /etc/tz ] && [ -r /shared/.hosttz ]; then
    echo "warn: часовой пояс не выставлен, /shared была недоступна" >&2
fi

exit 0
