#!/bin/sh
# sudo — обёртка над sud.
#
# Паролей в системе нет, поэтому спрашивать нечего и sudo работает
# без промедлений. Поддерживается ровно то, что нужно:
#
#   sudo <команда> [арг...]   выполнить от root, если команда разрешена
#   sudo -l                    показать белый список
#   sudo -h, --help            эта справка
#
# Опции настоящего sudo (-u, -i, -s, -g, роли, -l с пользователем)
# НЕ поддержаны: в системе один пользователь и один набор команд.
# Их неигнорирование молча было бы хуже, чем явный отказ.
BB=/bin/busybox
SUD=/usr/local/bin/sud

[ -x "$SUD" ] || {
    echo "sudo: нет $SUD — пересобери систему: ./build.sh" >&2
    exit 1
}

usage() {
    cat <<'EOF'
usage: sudo <команда> [аргументы]
       sudo -l            список разрешённых команд
       sudo -h            эта справка

Пароля нет: sudo выполняет команду сразу. Разрешены только команды
из белого списка — полный список: sudo -l
EOF
}

# Уже root — просто выполняем.
if [ "$(id -u)" = 0 ]; then
    [ $# -gt 0 ] || { usage; exit 1; }
    exec "$@"
fi

# Отбрасываем опции, которые для нас ничего не значат, иначе sud
# принял бы «-n» за имя команды.
while [ $# -gt 0 ]; do
    case "$1" in
        -n|-k|-A|-S|-P|-C) shift ;;
        -p) shift 2 ;;
        -p*) shift ;;
        --) shift; break ;;
        -h|--help) usage; exit 0 ;;
        -l|--list) exec "$SUD" --list ;;
        -v|--version) echo "sudo 0.1 (обёртка над sud)"; exit 0 ;;
        -u|-g|-U|-C|-p|-i|-s|-t)
            printf 'sudo: опция %s не поддерживается, паролей и ролей тут нет\n' "$1" >&2
            printf '  список того, что можно: sudo -l\n' >&2
            exit 1 ;;
        -*) printf 'sudo: неизвестная опция %s\n' "$1" >&2
            printf '  sudo -l покажет разрешённые команды\n' >&2
            exit 1 ;;
        *) break ;;
    esac
done

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

exec "$SUD" "$@"
