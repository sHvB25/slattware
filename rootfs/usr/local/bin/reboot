#!/bin/sh
# /usr/local/bin/reboot — перезагрузка системы.
#
# По той же причине, что и в poweroff, dinitctl shutdown здесь не
# используется: он не может отпустить консоль, пока на ней висит
# шелл, из которого вызвана команда. Подробности в poweroff.

BB=/bin/busybox

# Остановить всё, кроме сервиса консоли (boot).
stop_services() {
    [ -x /bin/dinitctl ] || return 0
    for s in net share hostname etc; do
        $BB dinitctl stop "$s" >/dev/null 2>&1
    done
}

echo "синхронизирую диски..."
$BB sync

echo "размонтирую файловые системы..."
$BB umount -a -r 2>/dev/null

echo "перезагружаю..."
stop_services
$BB reboot -f