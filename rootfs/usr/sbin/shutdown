#!/bin/sh
# /usr/sbin/shutdown — команда, которую dinit выполняет при выключении.
#
# dinit останавливает все сервисы, потом запускает эту программу.
# Здесь синхронизируем диски, размонтируем ФС и гасим машину.
#
# Первый аргумент может быть -r / --reboot: dinit передаёт его,
# если выключение запрошено как перезагрузка.
#
# Раньше здесь лежал посторонний бинарник на 2.3 МБ (видимо, старая
# копия dinit). Он зависал на выключении, поэтому заменён скриптом.

BB=/bin/busybox

reboot=0
for a in "$@"; do
    case "$a" in
        -r|--reboot|reboot) reboot=1 ;;
    esac
done

if [ "$reboot" = 1 ]; then
    echo "перезагружаю систему..."
else
    echo "выключаю систему..."
fi

# Сбросить буферы на диск. Без sync после установки пакетов
# файловая система может потерять часть изменений.
$BB sync

# Размонтировать всё, кроме корня. -r: сделать read-only там,
# где отмонтировать не вышло. Лучше так, чем оставить грязную ФС.
$BB umount -a -r 2>/dev/null

if [ "$reboot" = 1 ]; then
    $BB reboot -f
else
    $BB poweroff -f
fi
